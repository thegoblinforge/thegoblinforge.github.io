---
const year = new Date().getFullYear();
---

<footer class="border-base-300 mt-16 border-t">
  <div
    class="text-base-content/70 mx-auto flex max-w-5xl flex-col items-start justify-between gap-4 px-6 py-8 text-sm sm:flex-row sm:items-center"
  >
    <p>
      © {year} thegoblinforge — forged by
      <a
        href="https://github.com/donreno"
        class="link link-hover text-base-content"
        rel="noopener"
      >
        Renato San Martin
      </a>.
    </p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/donreno"
        class="link link-hover"
        rel="noopener"
        aria-label="GitHub"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/renato-sanmartin/"
        class="link link-hover"
        rel="noopener"
        aria-label="LinkedIn"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
